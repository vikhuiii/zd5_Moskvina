<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zd4_moskvina_.CarouselPage3"
             Title="Элементы управления">

  <ContentPage.Resources>
    <StyleSheet Source="/mystyles.css" />
  </ContentPage.Resources>

  <ContentPage.Content>
    <Grid BackgroundColor="#2d2d2d" Padding="10">

      <!-- строки: каждая группа в своей строке; между контентом и футером — растяжка -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/> <!-- dropdown -->
        <RowDefinition Height="Auto"/> <!-- switches ON -->
        <RowDefinition Height="Auto"/> <!-- switches OFF -->
        <RowDefinition Height="Auto"/> <!-- switches dark ON -->
        <RowDefinition Height="Auto"/> <!-- switches dark OFF -->
        <RowDefinition Height="*"/>    <!-- spacer -->
        <RowDefinition Height="Auto"/> <!-- footer -->
      </Grid.RowDefinitions>

      <!-- Dropdown (row 0) -->
      <StackLayout Grid.Row="0" Orientation="Horizontal" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
        <Label Text="DROPDOWN:" TextColor="#ffffff" FontSize="14" VerticalOptions="Center"/>
        <Picker x:Name="dropdownPicker"
                Title="DROPDAWN"
                StyleClass="dropdown-button"
                HeightRequest="35"
                WidthRequest="200"
                SelectedIndexChanged="OnPickerSelectedIndexChanged">
          <Picker.Items>
            <x:String>Select one</x:String>
            <x:String>Select two</x:String>
            <x:String>Select three</x:String>
            <x:String>Select four</x:String>
          </Picker.Items>
        </Picker>
        <Label x:Name="selectedValueLabel" Text="" TextColor="#28a745" FontSize="12" VerticalOptions="Center"/>
      </StackLayout>

      <!-- Switch ON (row 1) -->
      <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,12,0,0">
        <Label Text="ON (accent)" TextColor="#ffffff" FontSize="14" VerticalOptions="Center"/>
        <Switch IsToggled="True" StyleClass="switch-on"/>
        <Switch IsToggled="True" StyleClass="switch-on"/>
        <Switch IsToggled="True" StyleClass="switch-on"/>
      </StackLayout>

      <!-- Switch OFF (row 2) -->
      <StackLayout Grid.Row="2" Orientation="Horizontal" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,12,0,0">
        <Label Text="OFF (light)" TextColor="#ffffff" FontSize="14" VerticalOptions="Center"/>
        <Switch IsToggled="False" StyleClass="switch-off"/>
        <Switch IsToggled="False" StyleClass="switch-off"/>
        <Switch IsToggled="False" StyleClass="switch-off"/>
      </StackLayout>

      <!-- Switch ON dark (row 3) -->
      <StackLayout Grid.Row="3" Orientation="Horizontal" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,12,0,0">
        <Label Text="ON (dark)" TextColor="#ffffff" FontSize="14" VerticalOptions="Center"/>
        <Switch IsToggled="True" StyleClass="switch-dark-on"/>
        <Switch IsToggled="True" StyleClass="switch-dark-on"/>
        <Switch IsToggled="True" StyleClass="switch-dark-on"/>
      </StackLayout>

      <!-- Switch OFF dark (row 4) -->
      <StackLayout Grid.Row="4" Orientation="Horizontal" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,12,0,0">
        <Label Text="OFF (dark)" TextColor="#ffffff" FontSize="14" VerticalOptions="Center"/>
        <Switch IsToggled="False" StyleClass="switch-dark-off"/>
        <Switch IsToggled="False" StyleClass="switch-dark-off"/>
        <Switch IsToggled="False" StyleClass="switch-dark-off"/>
      </StackLayout>

      <!-- Футер (row 6)-->
      <StackLayout Grid.Row="6" HorizontalOptions="FillAndExpand" VerticalOptions="End" Margin="0,20">
        <Label x:Name="userLabel" Text="" TextColor="#17a2b8" FontSize="14" HorizontalOptions="Center"/>
        <Label Text="← Свайпните влево/вправо для навигации →" TextColor="#888888" FontSize="14" HorizontalOptions="Center"/>
        <Label Text="Страница 3 из 4" TextColor="#888888" FontSize="12" HorizontalOptions="Center"/>
      </StackLayout>

    </Grid>
  </ContentPage.Content>
</ContentPage>